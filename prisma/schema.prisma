generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  /// workspace del dueño de la instancia: puede usar la cuenta de servicio de GSC compartida
  trusted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  projects  Project[]
  members   Membership[]
  plan String @default("trial")
  branding Json @default("{}")
  billing BillingOrder[]
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  planValidUntil DateTime?
  trialEndsAt DateTime @default(dbgenerated("(now() + '7 days'::interval)"))
  reportCredits Int @default(0)
  /// perfiles (proyectos) contratados en el plan pagado
  seats Int @default(1)
  /// suscripción de Mercado Pago vigente (preapproval)
  mpPreapprovalId String? @unique
  /// estado de esa suscripción en Mercado Pago: pending | authorized | paused | cancelled
  mpStatus String?
  quotaUsage QuotaUsage[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// scrypt$N$r$p$salt$hash
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  /// "sub" de Google (inicio de sesión con Google)
  googleSub    String?   @unique
  /// cuenta suspendida por el administrador: no puede entrar
  disabledAt   DateTime?
  memberships  Membership[]
  sessions     Session[]
  resets       PasswordReset[]
  verifications EmailVerification[]
}

model EmailVerification {
  /// hash del token
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// owner | admin | member
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

/// Sesión de navegador: se guarda el hash del token, nunca el token.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  /// hash del token
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Contadores de rate limit (login, recuperación, API).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  domain       String
  country      String   @default("cl")
  language     String   @default("es")
  locationCode Int      @default(2152)
  gscProperty  String?
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())

  runs        KeywordRun[]
  keywords    Keyword[]
  clusters    Cluster[]
  topics      Topic[]
  serps       SerpSnapshot[]
  crawls      Crawl[]
  psi         PsiResult[]
  inspections UrlInspection[]
  tracked     TrackedKeyword[]
  gscRows     GscRow[]
  gscDays     GscDay[]
  alerts      Alert[]
  contents    ContentAnalysis[]
  jobs        JobRun[]
  gscConnection  GscConnection?
  metaConnection MetaConnection?
  socialPosts    SocialPost[]
  socialImages   SocialImage[]
  igMedia        IgMedia[]
  igAccessRequests IgAccessRequest[]
  tasks ProjectTask[]
  explorations Exploration[]
  reports ReportSnapshot[]
  reportSchedule ReportSchedule?
  annotations Annotation[]
}

/// Conexión OAuth de Google Search Console del proyecto (la cuenta de Google del cliente). Token cifrado.
model GscConnection {
  projectId       String   @id
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  googleEmail     String?
  /// refresh token cifrado con AES-256-GCM (TOKEN_ENC_KEY)
  refreshTokenEnc String
  scope           String
  connectedBy     String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Estado temporal del flujo OAuth (anti-CSRF + PKCE).
model OAuthState {
  /// hash del state
  id           String   @id
  userId       String
  projectId    String
  codeVerifier String
  expiresAt    DateTime
  /// google | meta
  provider     String   @default("google")
}

model JobRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  refId     String?
  status    String   @default("queued") // queued | running | done | error
  progress  Int      @default(0)
  message   String?
  /// Eventos del job (fallback de LLM, respuestas crudas de APIs, avisos): [{ at, level, msg, data? }]
  log       Json     @default("[]")
  /// id del job en pg-boss (para cancelarlo)
  bossId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, kind, createdAt])
}

model KeywordRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seeds     String[]
  threshold Float    @default(0.45)
  /// Opciones del run: { volumeLive?: boolean } (DataForSEO Live en vez de standard queue)
  options   Json     @default("{}")
  status    String   @default("queued")
  stats     Json     @default("{}")
  /// Fuentes efectivamente usadas: { serp: real|none, embeddings: <modelo>|trigram-hash, volumes: real|none }
  sources   Json     @default("{}")
  createdAt DateTime @default(now())

  keywords Keyword[]
  clusters Cluster[]
  topics   Topic[]
}

model Keyword {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId       String?
  run         KeywordRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  term        String
  sources     String[]
  relevance   Float?
  volume      Int?
  /// Rangos de Keyword Planner (CSV): "100 – 1K" → 100 / 1000
  volumeMin   Int?
  volumeMax   Int?
  /// gsc | dataforseo | apify | csv
  volumeSource String?
  volumeAt    DateTime?
  cpc         Float?
  competition Float?
  intent      String?
  difficulty  Float?
  score       Float?
  excluded    Boolean   @default(false)
  /// Asignación keyword→cluster hecha a mano: el re-run no la cambia
  locked      Boolean   @default(false)
  clusterId   String?
  cluster     Cluster?  @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  embedding   Float[]
  createdAt   DateTime  @default(now())

  @@unique([projectId, term])
  @@index([runId])
}

model Cluster {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     String?
  run       KeywordRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  primary   String
  intent    String?
  volume    Int       @default(0)
  score     Float     @default(0)
  urls      String[]
  targetUrl String?
  topicId   String?
  topic     Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  isPillar  Boolean   @default(false)
  /// Ediciones manuales que el re-run respeta
  topicLocked  Boolean @default(false)
  nameLocked   Boolean @default(false)
  pillarLocked Boolean @default(false)
  pos       Json?
  keywords  Keyword[]
}

model Topic {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     String?
  run       KeywordRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  pos       Json?
  /// Creado por el fallback average-linkage (HDBSCAN no separó nada)
  forcedSplit Boolean @default(false)
  nameLocked  Boolean @default(false)
  clusters  Cluster[]
}

model SerpSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword   String
  depth     Int      @default(10)
  source    String   @default("deep") // deep | quick
  organic   Json
  paa       String[]
  related   String[]
  features  String[]
  aiOverview Json?
  fetchedAt DateTime @default(now())

  @@index([projectId, keyword, fetchedAt])
}

model Crawl {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// queued | running | completed | partial | failed | cancelled
  status     String   @default("queued")
  /// por qué quedó parcial, fallido o cancelado (texto para el usuario)
  reason     String?
  options    Json     @default("{}")
  stats      Json     @default("{}")
  robots     String?
  sitemapUrls Int     @default(0)
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  pages      Page[]
  issues     Issue[]
}

model Page {
  id            String   @id @default(cuid())
  crawlId       String
  crawl         Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url           String
  finalUrl      String?
  status        Int
  redirects     Json     @default("[]")
  contentType   String?
  title         String?
  titleLen      Int      @default(0)
  metaDesc      String?
  metaLen       Int      @default(0)
  h1            String[]
  canonical     String?
  canonicalType String?  // self | other | none
  noindex       Boolean  @default(false)
  /// meta robots / X-Robots-Tag con nofollow: Google no sigue sus links
  nofollow      Boolean  @default(false)
  hreflang      Json     @default("[]")
  jsonldTypes   String[]
  jsonldErrors  Int      @default(0)
  wordCount     Int      @default(0)
  imgNoAlt      Int      @default(0)
  inlinks       Int      @default(0)
  outlinks      Int      @default(0)
  links         String[]
  responseMs    Int      @default(0)
  depth         Int      @default(0)
  contentHash   String?
  inSitemap     Boolean  @default(false)
  orphan        Boolean  @default(false)
  blocked       Boolean  @default(false)
  /// blocked_by_waf | ssrf_blocked | fetch_failed (la página no es válida)
  error         String?
  /// solo con render JS: links que aparecen al ejecutar JavaScript y no están en el HTML inicial
  jsLinks       Int      @default(0)
  /// solo con render JS: palabras en el HTML inicial (antes de ejecutar JavaScript)
  rawWordCount  Int?
  /// diferencias entre los datos estructurados (Product/Offer/Rating) y lo visible en la página
  schemaIssues  String[]

  @@unique([crawlId, url])
}

model Issue {
  id       String @id @default(cuid())
  crawlId  String
  crawl    Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url      String
  code     String
  severity String // critical | warning | info
  detail   String?

  @@index([crawlId, severity])
}

model PsiResult {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  strategy  String
  score     Int?
  lab       Json
  field     Json
  createdAt DateTime @default(now())
}

model UrlInspection {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url             String
  verdict         String?
  coverageState   String?
  googleCanonical String?
  userCanonical   String?
  lastCrawl       DateTime?
  raw             Json
  createdAt       DateTime @default(now())
}

model TrackedKeyword {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword   String
  frequency String      @default("weekly") // daily | weekly
  depth     Int         @default(10)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  checks    RankCheck[]

  @@unique([projectId, keyword])
}

model RankCheck {
  id          String         @id @default(cuid())
  trackedId   String
  tracked     TrackedKeyword @relation(fields: [trackedId], references: [id], onDelete: Cascade)
  date        DateTime       @default(now())
  position    Int?
  url         String?
  features    String[]
  competitors Json           @default("[]")

  @@index([trackedId, date])
}

model GscRow {
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  query       String
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@id([projectId, date, query, page])
  @@index([projectId, query])
}

/// Totales diarios del sitio (dimensión solo fecha): incluyen las consultas anonimizadas que GscRow no trae.
model GscDay {
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@id([projectId, date])
}

model Alert {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   // drop | cannibal | lowctr
  key       String
  data      Json
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId, seen])
}

model ContentAnalysis {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  keyword   String
  status    String   @default("queued")
  score     Int?
  result    Json     @default("{}")
  brief     Json     @default("{}")
  createdAt DateTime @default(now())
  versions BriefVersion[]
  pageKind String?
  /// el cupo de brief que consumió ya se devolvió (el análisis falló)
  quotaRefunded Boolean @default(false)
}

model CorpusTerm {
  lang String
  term String
  df   Int

  @@id([lang, term])
}

model CorpusMeta {
  lang String @id
  docs Int
}

/// Uso de proveedores externos: unidades, créditos, tokens y costo en USD (base del presupuesto mensual).
model ProviderUsage {
  id           String   @id @default(cuid())
  projectId    String?
  provider     String
  endpoint     String
  units        Int
  /// Costo en USD (informado por el proveedor o calculado con su tarifa)
  costUsd      Float?
  inputTokens  Int?
  outputTokens Int?
  model        String?
  ref          String?
  /// job que generó el gasto (para descontarlo de su reserva de presupuesto)
  jobRunId     String?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt], map: "ApiCall_projectId_createdAt_idx")
  @@index([provider, createdAt])
  @@index([jobRunId])
}

/// Caché global de volumen (sin importar el proyecto): país + idioma + keyword normalizada.
model VolumeCache {
  country     String
  language    String
  keyword     String
  source      String   // dataforseo | apify | csv
  volume      Int?
  volumeMin   Int?
  volumeMax   Int?
  cpc         Float?
  competition Float?
  intent      String?
  fetchedAt   DateTime @default(now())

  @@id([country, language, keyword, source])
  @@index([country, language, keyword, fetchedAt])
}

/// Cola de keywords para DataForSEO standard queue: se juntan keywords de varios proyectos por task.
model VolumeRequest {
  id           String   @id @default(cuid())
  country      String
  language     String
  locationCode Int
  keyword      String
  projectId    String?
  status       String   @default("pending") // pending | sent | done | error
  taskId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, locationCode, language])
  @@index([taskId])
}

/// Estado de proveedores externos (sin saldo, credenciales inválidas) para fallback automático y aviso en la UI.
model ProviderState {
  provider  String   @id
  status    String   // ok | no_balance | auth_error
  message   String?
  since     DateTime @default(now())
  /// Hasta cuándo se salta este proveedor antes de reintentar
  until     DateTime?
  updatedAt DateTime @updatedAt
}

/// Pulso de procesos de fondo (worker): si deja de latir, la UI avisa y los trabajos colgados se marcan.
model Heartbeat {
  name String   @id
  at   DateTime @default(now())
}

/// Reserva de presupuesto de un job en curso: su costo máximo queda apartado hasta que termina, así dos jobs
/// en paralelo no pueden pasarse juntos del límite mensual.
model BudgetReservation {
  holder    String
  provider  String
  usd       Float
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([holder, provider])
}

model ProjectTask {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint String
  title       String
  code        String?
  url         String?
  severity    String      @default("info")
  category    String      @default("improvement")
  reason      String
  status      String      @default("detected")
  source      String      @default("manual")
  priority    Float       @default(0)
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  lastCrawlId String?
  resolvedAt  DateTime?
  updatedAt   DateTime    @updatedAt
  events      TaskEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, priority])
}

model TaskEvent {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    String
  actor     String?
  crawlId   String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([taskId, createdAt])
}

model BriefVersion {
  id        String          @id @default(cuid())
  contentId String
  content   ContentAnalysis @relation(fields: [contentId], references: [id], onDelete: Cascade)
  brief     Json
  source    String
  actor     String?
  createdAt DateTime        @default(now())

  @@index([contentId, createdAt])
}

model Exploration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  graph     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ReportSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executive Json
  markdown  String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ReportSchedule {
  projectId String   @id
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  frequency String
  nextAt    DateTime
  enabled   Boolean  @default(true)
  /// correos que reciben el resumen de resultados al guardarse cada versión
  recipients String[] @default([])

  @@index([enabled, nextAt])
}

model BillingOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     String
  provider    String    @default("flow")
  providerId  String?   @unique
  amount      Int
  currency    String    @default("CLP")
  /// perfiles que cubre el pedido (plan pagado)
  seats       Int       @default(1)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([workspaceId, createdAt])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model QuotaUsage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resource    String
  amount      Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, resource, createdAt])
}

/// Conexión de Instagram (Instagram API con Instagram Login) del proyecto. Token cifrado.
model MetaConnection {
  projectId      String    @id
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ID de la cuenta profesional de Instagram (campo user_id de /me)
  igAccountId    String
  /// ID con alcance de app (campo id de /me): es el que llega en las notificaciones de eliminación de datos
  igScopedId     String?
  igAccountName  String
  /// token de larga duración cifrado con AES-256-GCM (TOKEN_ENC_KEY); se renueva solo antes de vencer
  accessTokenEnc String
  tokenExpiresAt DateTime?
  connectedBy    String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Post de Instagram generado o programado desde la app.
model SocialPost {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform    String    @default("instagram")
  caption     String
  /// /api/social/image/{id} (imagen guardada en SocialImage) o URL pública externa
  imageUrl    String?
  imagePrompt String?
  keywords    String[]
  /// draft | scheduled | publishing | published | failed
  status      String    @default("draft")
  metaPostId  String?
  scheduledAt DateTime?
  publishedAt DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([status, scheduledAt])
}

/// Imagen (JPEG) generada o subida para un post. Se sirve pública en /api/social/image/{id} para que Instagram la descargue.
model SocialImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Post de la cuenta de Instagram conectada con sus estadísticas (para el panel y para que la IA aprenda qué funciona).
model IgMedia {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId      String
  caption      String?
  mediaType    String?
  permalink    String?
  postedAt     DateTime
  reach        Int?
  likes        Int?
  comments     Int?
  saved        Int?
  shares       Int?
  interactions Int?
  syncedAt     DateTime @updatedAt

  @@unique([projectId, mediaId])
  @@index([projectId, postedAt])
}

/// Pedido de un cliente para habilitar su Instagram mientras la app de Meta está en prueba (se agrega como Instagram Tester).
model IgAccessRequest {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  /// usuario de Instagram sin @
  username  String
  /// pending | invited | connected | rejected
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, username])
  @@index([status, createdAt])
}

/// Ideas enviadas desde el formulario público de fsvc.cl/ventures.
model IdeaSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  /// idea | app | fisico | startup
  stage     String
  idea      String
  needs     String[]
  link      String?
  ip        String?
  /// new | contacted | declined | accepted
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cambio publicado en el sitio (o tarea resuelta) para medir su efecto en Search Console antes/después.
model Annotation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  /// URL exacta, sección (/blog/*) o vacío = todo el sitio
  scope     String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([projectId, date])
}
