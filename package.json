    "postcss": "^8.5.29",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@xyflow/react": "^12.12.0",
    "cheerio": "^1.0.0",
    "google-auth-library": "^9.15.1",
    "next": "^14.2.35",
    "p-limit": "^3.1.0",
    "pg-boss": "^10.4.2",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
