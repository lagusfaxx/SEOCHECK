{
  "name": "seocheck",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
