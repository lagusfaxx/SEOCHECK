POSTGRES_PASSWORD=cambia-esto
# Acceso: usuarios con email y contraseña (la primera vez se crea el dueño en /setup).
# BASIC_AUTH es una capa extra opcional encima del login.
BASIC_AUTH=
# URL pública (para los links de recuperación e invitaciones)
APP_URL=https://seo.tudominio.cl
# true = cualquiera puede crear cuenta (con su propio workspace). Por defecto solo por invitación.
SIGNUP_ENABLED=false
# Correo para recuperación e invitaciones (Resend). Sin esto, el link se muestra a quien invita / queda en el log.
RESEND_API_KEY=
MAIL_FROM=SEOCHECK <no-reply@tudominio.cl>

SERPENT_API_KEY=
# Volumen: cadena en orden (GSC con impresiones manda siempre). Sin credenciales o sin saldo → siguiente.
VOLUME_PROVIDERS=dataforseo,apify,csv
PROVIDER_RETRY_HOURS=6
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# live | sandbox (gratis, datos ficticios)
DATAFORSEO_ENV=live
# live (endpoint Live) | queue (standard queue multi-proyecto)
DATAFORSEO_MODE=live
DATAFORSEO_QUEUE_WAIT_SECONDS=300
# Apify (opcional)
APIFY_TOKEN=
# s-r~google-keywords | steadyfetch~keyword-search-volume-scraper
APIFY_ACTOR_ID=s-r~google-keywords
# exact (un run por keyword, limit=1) | seed (variantes por seed); solo s-r~google-keywords
APIFY_MODE=exact
APIFY_CONCURRENCY=3

# Embeddings: por defecto el servicio local `embeddings`. Vacío + OPENAI_API_KEY => text-embedding-3-small
EMBEDDINGS_URL=http://embeddings:80
OPENAI_API_KEY=

# LLM para intent dudoso y briefs: openai (default) | anthropic
LLM_PROVIDER=openai
# Default gpt-4o-mini (openai) o claude-sonnet-5-5 (anthropic)
LLM_MODEL=
ANTHROPIC_API_KEY=
# Tarifa para modelos no listados en src/lib/pricing.ts (USD por 1M tokens)
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=

PAGESPEED_API_KEY=
# JSON de la service account (crudo o en base64). Agrega su email como usuario de la propiedad en GSC.
GSC_SERVICE_ACCOUNT_JSON=
INDEXNOW_KEY=

# Render JS: docker compose --profile render up -d
BROWSER_WS_ENDPOINT=
BROWSER_TOKEN=seo

# Presupuesto mensual por proveedor (USD, mes calendario en TZ). -1 = sin límite, 0 = bloqueado.
SERPENT_MONTHLY_USD=3
LLM_MONTHLY_USD=2
DATAFORSEO_MONTHLY_USD=1
APIFY_MONTHLY_USD=0
# Tarifas para estimar antes de llamar (el costo real se registra cuando el proveedor lo informa)
SERPENT_USD_PER_CALL=0.0006
DATAFORSEO_USD_PER_TASK=0.075

# Rank tracking: semanal por defecto (configurable por proyecto); día de la semana para las semanales (1=lunes)
RANK_WEEKDAY=1
RANK_CRON=0 6 * * *
GSC_CRON=0 7 * * *
TZ=America/Santiago
