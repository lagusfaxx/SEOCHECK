POSTGRES_PASSWORD=cambia-esto
BASIC_AUTH=usuario:clave

SERPENT_API_KEY=
# Volumen: cadena en orden (GSC con impresiones manda siempre). Sin credenciales o sin saldo → siguiente.
VOLUME_PROVIDERS=dataforseo,apify,csv
PROVIDER_RETRY_HOURS=6
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# live | sandbox (gratis, datos ficticios)
DATAFORSEO_ENV=live
# live (endpoint Live) | queue (standard queue multi-proyecto)
DATAFORSEO_MODE=live
DATAFORSEO_QUEUE_WAIT_SECONDS=300
# Apify (opcional)
APIFY_TOKEN=
# s-r~google-keywords | steadyfetch~keyword-search-volume-scraper
APIFY_ACTOR_ID=s-r~google-keywords
# exact (un run por keyword, limit=1) | seed (variantes por seed); solo s-r~google-keywords
APIFY_MODE=exact
APIFY_CONCURRENCY=3

# Embeddings: por defecto el servicio local `embeddings`. Vacío + OPENAI_API_KEY => text-embedding-3-small
EMBEDDINGS_URL=http://embeddings:80
OPENAI_API_KEY=

# LLM para intent dudoso y briefs (Anthropic preferido; si no, OpenAI)
ANTHROPIC_API_KEY=
# Por defecto claude-sonnet-5-5. Opus solo si lo pones aquí (p.ej. claude-opus-5-5).
LLM_MODEL=claude-sonnet-5-5

PAGESPEED_API_KEY=
# JSON de la service account (crudo o en base64). Agrega su email como usuario de la propiedad en GSC.
GSC_SERVICE_ACCOUNT_JSON=
INDEXNOW_KEY=

# Render JS: docker compose --profile render up -d
BROWSER_WS_ENDPOINT=
BROWSER_TOKEN=seo

RANK_CRON=0 6 * * *
GSC_CRON=0 7 * * *
TZ=America/Santiago
